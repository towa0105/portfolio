    .code {
        border: solid 1px #eaeaea;
        padding: 1rem;
        margin: 2rem 0;
    }
    .noteWrap {
        margin: 2rem 0;
        ul {
            list-style: disc;
            margin-left: 4rem;
        }
    }

    .case03 {
        border: solid 1px #bababa;
        padding: 1rem;
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        .member {
            padding: 1rem;
            &__name {
                border-bottom: dotted 1px #bababa;
            }
            &__age {
                font-weight: bold;
            }
            &__job {
                color: #148683;
            }
        }
    }
</style>

