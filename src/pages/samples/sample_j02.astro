---
import Layout from "../../layouts/Layout.astro";

const members = [
    { name: "瀧本", age: 18, job: "Webデザイナー" },
    { name: "桃井", age: 20, job: "プロデューサー" },
    { name: "田中", age: 22, job: "グラフィックデザイナー" },
    { name: "坂倉", age: 25, job: "Webエンジニア" },
    { name: "宮崎", age: 30, job: "カメラマン" },
    { name: "武田", age: 24, job: "コピーライター" },
];
---

<Layout pageTitle="Sample_j02 - 複数データとDOM操作">
    <main>
        <section class="sampleHeader">
            <h2>sample_j02 - 複数データとDOM操作</h2>
            <p>複数データを扱って、DOMの操作を実施する</p>
        </section>

        <div class="sampleContent">
            <section class="content">
                <h3>case01 配列の作成とforEach</h3>
                <p>下記を配列に作成してみましょう</p>
                <ul>
                    <li>Photoshop</li>
                    <li>Illustrator</li>
                    <li>Premiere</li>
                    <li>After Effects</li>
                    <li>VS Code</li>
                </ul>
            </section>
            <section class="content">
                <h3>case02 オブジェクト配列データ</h3>
                <p>
                    配列番号とは別に、添え字をつけてデータを入れる場合
                    オブジェクト配列で作成します
                </p>
                <h4>members配列を作成し、下記データを作成してみましょう</h4>
            </section>
            <section class="content">
                <h3>case03 データをHTMLに入れる</h3>
                <p>作成したメンバーのデータをHTMLへ出力しましょう</p>
                <div class="case03">
                    {
                        members.map((member) => (
                            <div class="member">
                                <p class="member__name">名前：{member.name}</p>
                                <p class="member__age">年齢：{member.age}</p>
                                <p class="member__job">職業：{member.job}</p>
                            </div>
                        ))
                    }
                </div>
            </section>
        </div>
    </main>
</Layout>
