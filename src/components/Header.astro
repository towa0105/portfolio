---
const { pathname } = Astro.url;

const navItems = [
    { label: "HOME", href: "/" },
    { label: "ABOUT", href: "/about/" },
    { label: "WORKS", href: "/samples/" },
    { label: "CONTACT", href: "/contact/" },
];

function isActive(path: string) {
    return path === "/" ? pathname === path : pathname.startsWith(path);
}
---

<header class="site-header">
    <div class="site-header__inner">
        <a class="brand" href="/" aria-label="細川永遠 Portfolio ホーム">
            <span class="brand__mark" aria-hidden="true">T</span>
            <span class="brand__text">
                <strong>TOWA</strong>
                <small>PORTFOLIO</small>
            </span>
        </a>

        <nav aria-label="メインナビゲーション">
            <ul>
                {navItems.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            class:list={["nav-link", isActive(item.href) && "active"]}
                            aria-current={isActive(item.href) ? "page" : undefined}
                        >
                            {item.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>

<style lang="scss">
    .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        padding: 1.4rem 2.4rem;
        background: rgb(255 255 255 / 92%);
        border-bottom: 1px solid rgb(11 7 93 / 12%);
        backdrop-filter: blur(14px);

        &__inner {
            display: flex;
            width: min(100%, 120rem);
            margin-inline: auto;
            align-items: center;
            justify-content: space-between;
            gap: 3.2rem;
        }
    }

    .brand {
        display: inline-flex;
        gap: 1rem;
        align-items: center;
        flex-shrink: 0;
        line-height: 1;

        &:link,
        &:visited,
        &:hover {
            color: #0b075d;
            text-decoration: none;
        }

        &:focus-visible {
            outline: 3px solid #11c7dc;
            outline-offset: 4px;
        }

        &__mark {
            display: grid;
            width: 3.6rem;
            aspect-ratio: 1;
            color: #fff;
            background: #0b075d;
            border-radius: 50%;
            place-items: center;
            font-size: 1.8rem;
            font-weight: 900;
            box-shadow: 0.4rem 0.4rem 0 #11c7dc;
        }

        &__text {
            display: grid;
            gap: 0.25rem;

            strong {
                font-size: 1.35rem;
                letter-spacing: 0.12em;
            }

            small {
                color: #77738b;
                font-size: 0.82rem;
                font-weight: 700;
                letter-spacing: 0.18em;
            }
        }
    }

    nav {
        min-width: 0;

        ul {
            display: flex;
            gap: clamp(1.6rem, 3vw, 3.6rem);
            align-items: center;
        }
    }

    .nav-link {
        position: relative;
        display: block;
        padding: 0.8rem 0;
        color: #0b075d;
        font-size: 1.05rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: 0.12em;

        &::after {
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            height: 0.25rem;
            background: #f45100;
            content: "";
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 180ms ease;
        }

        &:link,
        &:visited,
        &:hover {
            color: #0b075d;
            text-decoration: none;
        }

        &:hover::after,
        &.active::after {
            transform: scaleX(1);
            transform-origin: left;
        }

        &:focus-visible {
            outline: 3px solid #11c7dc;
            outline-offset: 3px;
        }
    }

    @media (max-width: 640px) {
        .site-header {
            padding: 1.2rem 1.6rem;

            &__inner {
                gap: 1.6rem;
            }
        }

        .brand__text {
            display: none;
        }

        nav {
            overflow-x: auto;

            ul {
                gap: 1.1rem;
                width: max-content;
            }
        }

        .nav-link {
            font-size: 0.88rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .nav-link::after {
            transition: none;
        }
    }
</style>
